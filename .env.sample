AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=us-east-1
AWS_NOVA_ACT_WORKFLOW_NAME=Reachy-Nova

# Slack integration (Socket Mode)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_CHANNEL_IDS=C01234567,C89012345

# Feedback S3 upload
FEEDBACK_S3_BUCKET=reachy-nova-feedback
FEEDBACK_STORAGE=local+s3  # local, local+s3, or s3

# MQTT (Nervous System)
MQTT_BROKER=localhost
MQTT_PORT=1883

# Wake word detection (Parakeet TDT ASR)
WAKE_WORD_PHRASE=wake up nova                         # spoken phrase that wakes the robot
WAKE_WORD_MODEL=nvidia/parakeet-tdt-0.6b-v2         # NeMo model name or local checkpoint path

# Nova Sonic tuning (harness, fast-witty-remembering-nova round)
# NOVA_SONIC_ENDPOINTING=HIGH        # turn-detection sensitivity: HIGH|MEDIUM|LOW; HIGH answers fastest but may cut off slow speakers (default HIGH)
# NOVA_SONIC_SPEECH_FLOOR=0.02       # mic RMS above which a chunk counts as "input flowing" for the liveness watchdog, so a quiet room never trips it (default 0.01)
# NOVA_SONIC_ROTATE_S=420            # session age at which a healthy stream is proactively rotated at the next idle moment; 0 disables proactive rotation (default 420, ~7 min)
# NOVA_SONIC_ROTATE_DEADLINE_S=470   # session age past which rotation happens regardless of what is in flight, just ahead of Bedrock's own ~480s ceiling (default 470)

# Feature switches (harness) — 0/false/off/no turns a switch off; an unset,
# empty, or unrecognised value means on (fail-open, logged once at start)
# NOVA_CHUNKED_PLAYBACK=1   # speak in ~1s chunks as Sonic generates instead of buffering the whole utterance (default on)
# NOVA_LITE_REACTIONS=1     # let Nova 2 Lite shape one-line reactions for cues that opt in (react: lite); off falls back to the plain template inject (default on)
# NOVA_MEMORY=1             # keep the conversation ledger + Lite memory compaction, replayed at every session start; off means no ledger and no replay (default on)
# NOVA_PERSONA_PATH=config/persona/nova.md   # persona file the harness loads at startup; missing/unreadable falls back to an embedded default persona (default: config/persona/nova.md)